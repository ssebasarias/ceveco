# =============================================================================
# Ceveco — .gitignore
# =============================================================================

# Dependencias
node_modules/
backend/node_modules/
frontend/node_modules/
frontend/.tailwindcache

# Entorno y secretos
.env
.env.production
.env.local
.env.*.local
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log
debug_log.txt

# Editor y sistema
.vscode/
.idea/
.DS_Store
Thumbs.db
*.ps1

# Docker
docker-compose.override.yml

# Testing
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Build artifacts
dist/
build/
coverage/

# Claude Code / agent workspaces
.claude/
.agent/
.playwright-mcp/

# Documentación de proceso (specs/plans generados por agentes durante desarrollo)
docs/superpowers/

# Carpetas y archivos temporales / de monitoreo
.backup-pre-restore/
*.tmp
verify-*.png
*-screenshot.png

# Database backups — ignora todo lo de dentro pero NO la carpeta misma,
# así podemos excluir excepciones (ceveco-seed.sql) explícitamente.
backups/*
*.backup
*.dump

# Cualquier .sql suelto fuera de carpetas controladas
*.sql

# Excepciones: archivos versionados necesarios para producción
!migrations/*.sql
!bd.sql
!backups/ceveco-seed.sql

# SSL certs gestionados por certbot (NO commitear claves)
certbot/conf/
certbot/www/
