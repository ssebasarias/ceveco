# =============================================================================
# .env.example — copia este archivo a `.env` y completa los valores reales.
# El stack de Docker (docker-compose.prod.yml) y deploy.sh leen este .env.
# El backend además acepta backend/.env si lo prefieres separado en local.
# =============================================================================

# --- Servidor ----------------------------------------------------------------
PORT=3000
NODE_ENV=production            # local: development

# --- Base de Datos ------------------------------------------------------------
# En el stack de Docker (compose) el host es el nombre del servicio: db
# En local nativo usar: localhost
DB_HOST=db
DB_PORT=5432
DB_NAME=ceveco_db
DB_USER=postgres
DB_PASSWORD=cambiar_a_password_segura

# --- Seguridad (JWT) ----------------------------------------------------------
# Generar con: openssl rand -hex 64
JWT_SECRET=cambiar_a_string_aleatorio_largo
JWT_EXPIRES_IN=7d

# --- Email (Nodemailer + Gmail) ----------------------------------------------
# Generar App Password en Cuenta Google → Seguridad → Verif. 2 pasos
EMAIL_USER=
EMAIL_PASS=

# --- Producción: HTTPS y dominio ---------------------------------------------
# Dominio (sin https://). DNS A record debe apuntar al servidor ANTES de --first.
DOMAIN=ceveco.com.co
# Email para notificaciones de Let's Encrypt (expiración del cert, etc.)
CERTBOT_EMAIL=admin@ceveco.com.co
# STAGING=1 para usar el ambiente de pruebas de Let's Encrypt (sin rate-limits).
# Dejar comentado o =0 para producción.
# STAGING=0

# --- OAuth opcional -----------------------------------------------------------
GOOGLE_CLIENT_ID=

# --- Frontend URL (CORS y reset password emails) -----------------------------
FRONTEND_URL=https://ceveco.com.co
